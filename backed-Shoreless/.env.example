# Copia este archivo a .env y completa los valores del add-on MySQL de Clever Cloud.
# No subas el archivo .env al repositorio.

MYSQL_ADDON_HOST=
MYSQL_ADDON_DB=
MYSQL_ADDON_USER=
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_PASSWORD=
PORT=3001

# Secreto para firmar el token de acceso. En producción usa una cadena larga y aleatoria.
JWT_SECRET=

# Si este correo se registra, la cuenta queda como administrador.
ADMIN_EMAIL=

# Carpeta local de imágenes y modelos. En Clever Cloud el disco es efímero;
# para producción conviene un almacenamiento de objetos (Cellar) detrás de src/lib/archivos.js.
STORAGE_DIR=./storage

# Orígenes del frontend separados por coma. Los dominios *.vercel.app también se aceptan.
FRONTEND_ORIGIN=http://localhost:5173

# Secreto para firmar los tokens de acceso. Usa una cadena larga y aleatoria.
JWT_SECRET=

# mysql = guarda imágenes y modelos en Clever Cloud (necesario en Vercel).
# Si se omite, en local los archivos quedan en la carpeta storage/.
STORAGE_BACKEND=

# Clave para crear las tablas una sola vez: POST /api/admin/iniciar
# Header: x-init-key: <INIT_KEY>
INIT_KEY=
